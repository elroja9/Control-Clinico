 8000 : 4500);\n\n  useEffect(() => {\n    if (paused) return;\n    const start = Date.now();\n    const timer = setTimeout(() => dismissToast(toast.id), remaining.current);\n    return () => {\n      clearTimeout(timer);\n      remaining.current -= Date.now() - start;\n    };\n  }, [paused, toast.id]);\n\n  const { icon: Icon, ring, iconColor } = TOAST_STYLES[toast.tone];\n  const urgent = toast.tone === 'error' || toast.tone === 'warning';\n\n  return (\n    <div\n      role={urgent ? 'alert' : 'status'}\n      onMouseEnter={() => setPaused(true)}\n      onMouseLeave={() => setPaused(false)}\n      onFocus={() => setPaused(true)}\n      onBlur={() => setPaused(false)}\n      className={`pointer-events-auto w-full sm:w-96 bg-white border ${ring} shadow-lg shadow-slate-900/10 rounded-2xl p-3.5 flex items-start gap-3 animate-toast-in`}","node_kind":"component"},{"id":"feedback_confirmdialog","label":"ConfirmDialog()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L133-L189","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L133"}],"snippet":"function ConfirmDialog({ request }: { request: ConfirmRequest; key?: number }) {\n  const titleId = useId();\n  const descId = useId();\n  const ref = useDialog<HTMLDivElement>(true, () => resolveConfirm(request.id, false));\n  const tone = request.tone ?? 'default';\n  const Icon = tone === 'danger' ? AlertCircle : tone === 'warning' ? AlertTriangle : Info;\n  const iconBox = tone === 'danger' ? 'bg-rose-50 text-rose-600' : tone === 'warning' ? 'bg-amber-50 text-amber-600' : 'bg-sky-50 text-sky-600';\n  const confirmBtn = tone === 'danger'\n    ? 'bg-rose-600 hover:bg-rose-700 text-white'\n    : tone === 'warning'\n    ? 'bg-amber-600 hover:bg-amber-700 text-white'\n    : 'bg-slate-900 hover:bg-slate-800 text-white';\n\n  return (\n    <div className=\"fixed inset-0 z-[70] bg-slate-900/50 backdrop-blur-xs flex items-end sm:items-center justify-center p-4 animate-fade-in\">\n      <div\n        ref={ref}\n        role=\"alertdialog\"\n        aria-modal=\"true\"\n        aria-labelledby={titleId}\n        aria-describedby={request.message ? descId : undefined}\n        tabIndex={-1}\n        className=\"w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-200 p-6 animate-dialog-in focus:outline-hidden\"\n      >\n        <div className=\"flex items-start gap-4\">","node_kind":"component"},{"id":"feedback_feedbackhost","label":"FeedbackHost()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L191-L207","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L191"}],"snippet":"export function FeedbackHost() {\n  const { toasts, confirms } = useSyncExternalStore(subscribe, () => state, () => state);\n  const current = confirms[0];\n\n  return (\n    <>\n      <div\n        aria-live=\"polite\"\n        className=\"fixed z-[80] inset-x-0 bottom-0 sm:inset-x-auto sm:right-0 p-4 flex flex-col items-stretch sm:items-end gap-2 pointer-events-none print:hidden\"\n        style={{ paddingBottom: 'max(1rem, env(safe-area-inset-bottom))' }}\n      >\n        {toasts.map(t => <ToastCard key={t.id} toast={t} />)}\n      </div>\n      {current && <ConfirmDialog key={current.id} request={current} />}\n    </>\n  );\n}","node_kind":"component"}],"edges":[{"source":"feedback","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ui/Feedback.tsx","source_location":"L1"}],"weight":1},{"source":"feedb