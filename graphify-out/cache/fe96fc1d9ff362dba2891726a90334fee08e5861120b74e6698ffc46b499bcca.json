);\n\n  useEffect(() => {\n    if (!mapsListo) return;\n    const input = document.getElementById('mi-perfil-direccion-input') as HTMLInputElement | null;\n    if (!input) return;\n    const autocomplete = new (window as any).google.maps.places.Autocomplete(input, { fields: ['formatted_address', 'geometry'] });\n    autocomplete.addListener('place_changed', () => {\n      const place = autocomplete.getPlace();\n      if (place.geometry?.location) {\n        setUbicacionDireccion(place.formatted_address || input.value);","node_kind":"component"},{"id":"myprofile_myprofile_handlesave","label":"handleSave()","file_type":"code","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L42-L47","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L42"}],"snippet":"handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSaveUser({ ...currentUser, ubicacionDireccion, ubicacionLat, ubicacionLng, maxTiempoTrasladoMinutos });\n    setGuardado(true);\n    setTimeout(() => setGuardado(false), 2500);\n  }"}],"edges":[{"source":"myprofile","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L1"}],"weight":1},{"source":"myprofile","target":"mockdata","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/MyProfile.tsx","source_location":"L2"}],"weight":1},{"source":"myprofile","target":"lucide_react","relation":"imports_from",