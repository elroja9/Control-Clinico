,"source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L254"}],"snippet":"handleLogin = (user: User, companyId: number) => {\n    setCurrentUser(user);\n    setSelectedCompanyId(companyId);\n    setActiveTab('dashboard');\n  }"},{"id":"app_app_handleregistercompany","label":"handleRegisterCompany()","file_type":"code","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L260-L293","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L260"}],"snippet":"handleRegisterCompany = (newCompany: Company, newAdminUser: User) => {\n    fetch('/api/companies', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(newCompany)\n    })\n    .then(res => res.json())\n    .then(savedCompany => {\n      setCompanies(prev => {\n        const exists = prev.some(c => c.id === savedCompany.id);\n        return exists ? prev.map(c => c.id === savedCompany.id ? savedCompany : c) : [...prev, savedCompany];\n      });\n      \n      const userToSave = { ...newAdminUser, idCompania: savedCompany.id };\n      return fetch('/api/users', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(userToSave)\n      });\n    })\n    .then(res => res.json())\n    .then(savedUser => {\n      setUsers(prev => {\n        const exists = prev.some(u => u.id === savedUser.id);\n        return exists ? prev.map(u => u.id === savedUser.id ? savedUser : u) : [...prev, savedUser];"},{"id":"app_app_handlelogout","label":"handleLogout()","file_type":"code","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L295-L298","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L295"}],"snippet":"handleLogout = () => {\n    setCurrentUser(null);\n    localStorage.removeItem('fisio_current_user');\n  }"},{"id":"app_app_handlesavepatient","label":"handleSavePatient()","file_type":"code","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L327-L351","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L327"}],"snippet":"handleSavePatient = (savedPatient: Patient) => {\n    fetch('/api/patients', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(savedPatient)\n    })\n    .then(res => res.json())\n    .then(data => {\n      setPatients(prev => {\n        const exists = prev.some(p => p.id === data.id);\n        return exists ? prev.map(p => p.id === data.id ? data : p) : [...prev, data];\n      });\n    })\n    .catch(err => {\n      console.error(\"Error saving patient to MySQL:\", err);\n      const exists = patients.some(p => p.id === savedPatient.id);\n      if (exists) {\n        setPatients(prev => prev.map(p => p.id === savedPatient.id ? savedPatient : p));\n      } else {\n        setPatients(prev => [...prev, savedPatient]);\n      }\n    });\n    setIsAddingPatient(false);\n    setEditingPatient(null);\n  }"},{"id":"app_app_handledeletepatient","label":"handleDeletePatient()","file_type":"code","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L353-L357","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L353"}],"snippet":"handleDeletePatient = (id: number) => {\n    if (confirm(\"¿Está seguro de eliminar el expediente de este paciente? Esto no borrará sus consultas históricas.\")) {\n      setPatients(prev => prev.filter(p => p.id !== id));\n    }\n  }"},{"id":"app_app_handlesaveconsultation","label":"handleSaveConsultation()","file_type":"code","source_file":"D:/Control-Clinico/src/App.tsx","source_location":"L359-L37