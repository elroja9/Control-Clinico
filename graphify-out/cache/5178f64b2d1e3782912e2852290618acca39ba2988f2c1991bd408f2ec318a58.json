{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"cxcmanager","label":"CxCManager.tsx","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L1"}]},{"id":"cxcmanager_cxcmanagerprops","label":"CxCManagerProps","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L6-L10","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L6"}],"snippet":"interface CxCManagerProps {\n  cxc: CuentaCobrar[];\n  patients: Patient[];\n  onRegistrarPago: (idCuentaCobrar: number, monto: number, medioPago: string, referencia: string) => Promise<void>;\n}"},{"id":"cxcmanager_hoyiso","label":"hoyISO()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L21-L23","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L21"}],"snippet":"function hoyISO(): string {\n  return fechaCR();\n}"},{"id":"cxcmanager_estadoefectivo","label":"estadoEfectivo()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L25-L28","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L25"}],"snippet":"function estadoEfectivo(c: CuentaCobrar): 'PENDIENTE' | 'VENCIDA' | 'PAGADA' | 'ANULADA' {\n  if (c.estado !== 'PENDIENTE') return c.estado;\n  return c.fechaVencimiento < hoyISO() ? 'VENCIDA' : 'PENDIENTE';\n}"},{"id":"cxcmanager_cxcmanager","label":"CxCManager()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L37-L230","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L37"}],"snippet":"export default function CxCManager({ cxc, patients, onRegistrarPago }: CxCManagerProps) {\n  const [filtro, setFiltro] = useState<'TODAS' | 'PENDIENTE' | 'VENCIDA' | 'PAGADA'>('TODAS');\n  const [abonandoId, setAbonandoId] = useState<number | null>(null);\n  const [montoAbono, setMontoAbono] = useState('');\n  const [medioPagoAbono, setMedioPagoAbono] = useState('01');\n  const [referenciaAbono, setReferenciaAbono] = useState('');\n  const [guardando, setGuardando] = useState(false);\n  const [error, setError] = useState('');\n\n  const nombrePaciente = (idPaciente: number) => patients.find(p => p.id === idPaciente)?.nombreCompleto || `Paciente #${idPaciente}`;\n\n  const ordenadas = [...cxc].sort((a, b) => b.fechaEmision.localeCompare(a.fechaEmision));\n  const visibles = ordenadas.filter(c => filtro === 'TODAS' || estadoEfectivo(c) === filtro);\n\n  const totalPendiente = cxc.filter(c => estadoEfectivo(c) !== 'PAGADA' && c.estado === 'PENDIENTE').reduce((s, c) => s + c.saldoPendiente, 0);\n  const totalVencido = cxc.filter(c => estadoEfectivo(c) === 'VENCIDA').reduce((s, c) => s + c.saldoPendiente, 0);\n  const totalCobrado = cxc.reduce((s, c) => s + c.pagos.reduce((sp, p) => sp + p.monto, 0), 0);\n\n  const abrirAbono = (c: CuentaCobrar) => {\n    setAbonandoId(c.id);\n    setMontoAbono(c.saldoPendiente.toString());\n    setMedioPagoAbono('01');\n    setReferenciaAbono('');\n    setError('');\n  };","node_kind":"component"},{"id":"cxcmanager_cxcmanager_nombrepaciente","label":"nombrePaciente()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxCManager.tsx","source_location":"L46","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","st