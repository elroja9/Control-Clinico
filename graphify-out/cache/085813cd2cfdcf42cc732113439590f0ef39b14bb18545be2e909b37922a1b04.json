Cita.id : Math.max(...citas.map(c => c.id), 0) + 1;\n\n    const savedCita: Cita = {\n      id: nextId,\n      idCompania: activeCompanyId,\n      idPaciente: patient.id,\n      idUsuarioNutricionista: formDoctorId,\n      idConsulta: selectedCita ? selectedCita.idConsulta : null,\n      fechaHora: fullFechaHora,\n      duracionMinutos: formDuration,\n      estadoCita: formStatus,\n      notas: formNotes"},{"id":"agendacalendar_agendacalendar_handledelete","label":"handleDelete()","file_type":"code","source_file":"D:/Control-Clinico/src/components/AgendaCalendar.tsx","source_location":"L240-L245","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/AgendaCalendar.tsx","source_location":"L240"}],"snippet":"handleDelete = (id: number) => {\n    if (confirm('¿Está seguro de eliminar de forma permanente esta cita de la agenda?')) {\n      onDeleteCita(id);\n      setIsFormOpen(false);\n    }\n  }"},{"id":"agendacalendar_agendacalendar_getstatuscolor","label":"getStatusColor()","file_type":"code","source_file":"D:/Control-Clinico/src/components/AgendaCalendar.tsx","source_location":"L248-L257","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/AgendaCalendar.tsx","source_location":"L248"}],"snippet":"getStatusColor = (status: Cita['estadoCita']) => {\n    switch (status) {\n      case 'PROGRAMADA': return 'bg-sky-50 border-sky-200 text-sky-700 hover:bg-sky-100';\n      case 'CONFIRMADA': return 'bg-emerald-50 border-emerald-200 text-emerald-700 hover:bg-emerald-100';\n      case 'CANCELADA': return 'bg-rose-50 border-rose-200 text-rose-700 hover:bg-rose-100 line-through';\n      case 'COMPLETADA': return 'bg-indigo-50 border-indigo-200 text-indigo-700 hover:bg-indigo-100';\n      case 'NO_ASISTIO': return 'bg-amber-50 border-amber-200 text-amber-700 hover:bg-amber-100';\n      default: return '