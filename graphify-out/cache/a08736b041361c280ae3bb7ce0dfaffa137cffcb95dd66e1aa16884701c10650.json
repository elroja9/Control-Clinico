{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"auth","label":"auth.ts","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L1"}]},{"id":"auth_getsessionkey","label":"getSessionKey()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L12-L18","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L12"}],"snippet":"function getSessionKey(): Buffer {\n  const secret = process.env.SESSION_SECRET;\n  if (!secret) {\n    throw new Error(\"SESSION_SECRET environment variable is required.\");\n  }\n  return crypto.createHash(\"sha256\").update(secret).digest();\n}"},{"id":"auth_sessionpayload","label":"SessionPayload","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L20-L24","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L20"}],"snippet":"export interface SessionPayload {\n  userId: number;\n  idCompania: number;\n  rol: \"Administrador\" | \"Profesional\";\n}"},{"id":"auth_createsessiontoken","label":"createSessionToken()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L26-L31","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L26"}],"snippet":"export function createSessionToken(payload: SessionPayload): string {\n  const body = JSON.stringify({ ...payload, exp: Date.now() + SESSION_TTL_MS });\n  const encoded = Buffer.from(body, \"utf8\").toString(\"base64url\");\n  const signature = crypto.createHmac(\"sha256\", getSessionKey()).update(encoded).digest(\"base64url\");\n  return `${encoded}.${signature}`;\n}"},{"id":"auth_verifysessiontoken","label":"verifySessionToken()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L33-L52","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L33"}],"snippet":"export function verifySessionToken(token: string): SessionPayload | null {\n  const [encoded, signature] = token.split(\".\");\n  if (!encoded || !signature) return null;\n\n  const expectedSignature = crypto.createHmac(\"sha256\", getSessionKey()).update(encoded).digest(\"base64url\");\n  const givenBuf = Buffer.from(signature);\n  const expectedBuf = Buffer.from(expectedSignature);\n  if (givenBuf.length !== expectedBuf.length || !crypto.timingSafeEqual(givenBuf, expectedBuf)) {\n    return null;\n  }\n\n  try {\n    const body = JSON.parse(Buffer.from(encoded, \"base64url\").toString(\"utf8\"));\n    if (typeof body.exp !== \"number\" || Date.now() > body.exp) return null;\n    if (typeof body.userId !== \"number\" || typeof body.idCompania !== \"number\") return null;\n    return { userId: body.userId, idCompania: body.idCompania, rol: body.rol };\n  } catch {\n    return null;\n  }\n}"},{"id":"auth_isbcrypthash","label":"isBcryptHash()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L56-L58","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L56"}],"snippet":"export function isBcryptHash(value: string): boolean {\n  return BCRYPT_HASH_PATTERN.test(value);\n}"},{"id":"auth_passwordmatches","label":"passwordMatches()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L63-L68","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L63"}],"snippet":"export function passwordMatches(stored: string, input: string): boolean {\n  if (isBcryptHash(stored)) {\n    return bcrypt.compareSync(input, stored);\n  }\n  return stored === input;\n}"},{"id":"auth_hashpassword","label":"hashPassword()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L70-L72","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L70"}],"snippet":"export function hashPassword(plain: string): string {\n  return bcrypt.hashSync(plain, 10);\n}"},{"id":"auth_generatenumericpassword","label":"generateNumericPassword()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L76-L80","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L76"}],"snippet":"export function generateNumericPassword(digits: number): string {\n  const min = Math.pow(10, digits - 1);\n  const max = Math.pow(10, digits) - 1;\n  return crypto.randomInt(min, max + 1).toString();\n}"},{"id":"auth_issaasadmin","label":"isSaasAdmin()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L84-L86","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L84"}],"snippet":"export function isSaasAdmin(session: SessionPayload | null | undefined): boolean {\n  return !!session && session.idCompania === SAAS_ADMIN_COMPANY_ID && session.rol === \"Administrador\";\n}"},{"id":"auth_readcookie","label":"readCookie()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L89-L99","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L89"}],"snippet":"export function readCookie(cookieHeader: string | undefined, name: string): string | null {\n  if (!cookieHeader) return null;\n  for (const part of cookieHeader.split(\";\")) {\n    const eq = part.indexOf(\"=\");\n    if (eq === -1) continue;\n    if (part.slice(0, eq).trim() === name) {\n      return decodeURIComponent(part.slice(eq + 1).trim());\n    }\n  }\n  return null;\n}"},{"id":"auth_serializesessioncookie","label":"serializeSessionCookie()","file_type":"code","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L102-L104","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L102"}],"snippet":"export function serializeSessionCookie(value: string, maxAgeSeconds: number): string {\n  return `${SESSION_COOKIE}=${encodeURIComponent(value)}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${maxAgeSeconds}`;\n}"}],"edges":[{"source":"auth","target":"crypto","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L5"}],"weight":1},{"source":"auth","target":"bcryptjs","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L6","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L6"}],"weight":1},{"source":"auth","target":"auth_getsessionkey","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/auth.ts","source_location":"L12","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","st