{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"loginview","label":"LoginView.tsx","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L1"}]},{"id":"loginview_loginviewprops","label":"LoginViewProps","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L5-L8","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L5"}],"snippet":"interface LoginViewProps {\n  onLoginSuccess: (user: User, company: Company | undefined) => void;\n  onRegisterCompany: (company: Company, adminUser: User) => Promise<{ ok: boolean; error?: string }>;\n}"},{"id":"loginview_loginview","label":"LoginView()","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L10-L587","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L10"}],"snippet":"export default function LoginView({\n  onLoginSuccess,\n  onRegisterCompany\n}: LoginViewProps) {\n  const [view, setView] = useState<'login' | 'register' | 'pendiente' | 'olvide'>('login');\n\n  // Login states\n  const [username, setUsername] = useState('');\n  const [password, setPassword] = useState('');\n  const [loginError, setLoginError] = useState('');\n  const [loginSubmitting, setLoginSubmitting] = useState(false);\n  const [showPassword, setShowPassword] = useState(false);\n\n  // Forgot-password states\n  const [forgotUsuario, setForgotUsuario] = useState('');\n  const [forgotMessage, setForgotMessage] = useState('');\n  const [forgotOk, setForgotOk] = useState(false);\n  const [forgotSubmitting, setForgotSubmitting] = useState(false);\n\n  // Register Company states\n  const [compName, setCompName] = useState('');\n  const [compRazon, setCompRazon] = useState('');\n  const [compIdent, setCompIdent] = useState('');\n  const [compCorreo, setCompCorreo] = useState('');\n  const [compPerfil, setCompPerfil] = useState<'Fisioterapia' | 'Nutrición' | 'Ambas' | 'Spa'>('Ambas');","node_kind":"component"},{"id":"loginview_loginview_handleloginsubmit","label":"handleLoginSubmit()","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L45-L66","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L45"}],"snippet":"handleLoginSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginError('');\n    setLoginSubmitting(true);\n    try {\n      const res = await fetch('/api/login', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ usuario: username.trim(), password })\n      });\n      const data = await res.json();\n      if (!res.ok) {\n        setLoginError(data.error || 'No se pudo iniciar sesión.');\n        return;\n      }\n      onLoginSuccess(data.user, data.company);\n    } catch (err: any) {\n      setLoginError('No se pudo conectar con el servidor. Intente de nuevo.');\n    } finally {\n      setLoginSubmitting(false);\n    }\n  }"},{"id":"loginview_loginview_handleforgotsubmit","label":"handleForgotSubmit()","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L68-L88","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L68"}],"snippet":"handleForgotSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotMessage('');\n    if (!forgotUsuario.trim()) return;\n    setForgotSubmitting(true);\n    try {\n      const res = await fetch('/api/forgot-password', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ usuario: forgotUsuario.trim() })\n      });\n      const data = await res.json();\n      setForgotOk(res.ok);\n      setForgotMessage(res.ok ? data.message : (data.error || 'No se pudo procesar la solicitud.'));\n    } catch (err: any) {\n      setForgotOk(false);\n      setForgotMessage('No se pudo conectar con el servidor. Intente de nuevo.');\n    } finally {\n      setForgotSubmitting(false);\n    }\n  }"},{"id":"loginview_loginview_handleregistersubmit","label":"handleRegisterSubmit()","file_type":"code","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L90-L160","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/LoginView.tsx","source_location":"L90"}],"snippet":"handleRegisterSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setRegisterError('');\n\n    if (!compName || !compRazon || !compIdent || !compCorreo || !adminNombre || !adminUser || !adminCorreo || !adminPass) {\n      setRegisterError('Por favor complete todos los campos obligatorios.');\n      return;\n    }\n\n    setRegisterSubmitting(true);\n    try {\n      // id: 0 (falso) le indica al servidor que es un registro nuevo — el id real lo asigna\n      // la base de datos al insertar, en vez de adivinarlo aquí sin conocer el resto de\n      // empresas ya registradas (que ya no se cargan en esta vista sin haber iniciado sesión).\n      const newCompany: Company = {\n        id: 0,\n        nombreComercial: compName,\n        razonSocial: compRazon,\n        tipoIdentificacion: '02',\n        identificacion: compIdent,\n        correoEmisor: compCorreo,\n        ivaPorDefecto: 4.0,\n    