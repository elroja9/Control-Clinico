{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"crypto","label":"crypto.ts","file_type":"code","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L1"}]},{"id":"crypto_getkey","label":"getKey()","file_type":"code","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L5-L11","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L5"}],"snippet":"function getKey(): Buffer {\n  const hex = process.env.ENCRYPTION_KEY;\n  if (!hex || hex.length !== 64) {\n    throw new Error(\"ENCRYPTION_KEY environment variable is required and must be a 64-character hex string (32 bytes).\");\n  }\n  return Buffer.from(hex, \"hex\");\n}"},{"id":"crypto_encryptsecret","label":"encryptSecret()","file_type":"code","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L13-L20","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L13"}],"snippet":"export function encryptSecret(plain: string): string {\n  const key = getKey();\n  const iv = crypto.randomBytes(12);\n  const cipher = crypto.createCipheriv(ALGORITHM, key, iv);\n  const encrypted = Buffer.concat([cipher.update(plain, \"utf8\"), cipher.final()]);\n  const authTag = cipher.getAuthTag();\n  return `${iv.toString(\"hex\")}:${authTag.toString(\"hex\")}:${encrypted.toString(\"hex\")}`;\n}"},{"id":"crypto_decryptsecret","label":"decryptSecret()","file_type":"code","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L22-L36","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L22"}],"snippet":"export function decryptSecret(cipherText: string): string {\n  const parts = cipherText.split(\":\");\n  if (parts.length !== 3) {\n    throw new Error(\"Configura una contraseña SMTP real desde Ajustes de Empresa.\");\n  }\n  const [ivHex, authTagHex, dataHex] = parts;\n  const key = getKey();\n  const iv = Buffer.from(ivHex, \"hex\");\n  const authTag = Buffer.from(authTagHex, \"hex\");\n  const encrypted = Buffer.from(dataHex, \"hex\");\n  const decipher = crypto.createDecipheriv(ALGORITHM, key, iv);\n  decipher.setAuthTag(authTag);\n  const decrypted = Buffer.concat([decipher.update(encrypted), decipher.final()]);\n  return decrypted.toString(\"utf8\");\n}"}],"edges":[{"source":"crypto","target":"crypto","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L1"}],"weight":1},{"source":"crypto","target":"crypto_getkey","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L5"}],"weight":1},{"source":"crypto","target":"crypto_encryptsecret","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L13","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L13"}],"weight":1},{"source":"crypto","target":"crypto_decryptsecret","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/crypto.ts","source_location":"L22","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript