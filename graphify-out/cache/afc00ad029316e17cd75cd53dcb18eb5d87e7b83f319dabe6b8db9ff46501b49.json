{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"reportview","label":"ReportView.tsx","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L1"}]},{"id":"reportview_reportviewprops","label":"ReportViewProps","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L7-L28","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L7"}],"snippet":"interface ReportViewProps {\n  consultation: Consultation;\n  patient: Patient;\n  company: Company;\n  servicios: Servicio[];\n  facturas: Factura[];\n  onClose: () => void;\n  onNotificationSent: (log: NotificationLog) => void;\n  onConsultationUpdated: (consulta: Consultation) => void;\n  onCrearFactura: (payload: {\n    idCompania: number;\n    idCita: number | null;\n    idConsulta: number | null;\n    idPaciente: number;\n    condicionVenta: string;\n    medioPago: string;\n    montoRecibido: number | null;\n    modoPrueba: boolean;\n    lineas: Array<{ idServicio: number; cantidad: number }>;\n  }) => Promise<Factura>;\n  onVerificarEstadoFactura: (idFactura: number) => Promise<Factura>;\n}"},{"id":"reportview_gramosdesdemacropct","label":"gramosDesdeMacroPct()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L45-L48","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L45"}],"snippet":"function gramosDesdeMacroPct(pct: number | null, totalCalorias: number, kcalPorGramo: 4 | 9): number | null {\n  if (pct == null) return null;\n  return Math.round((pct / 100) * totalCalorias / kcalPorGramo);\n}"},{"id":"reportview_reportview","label":"ReportView()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L50-L555","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L50"}],"snippet":"export default function ReportView({ consultation, patient, company, servicios, facturas, onClose, onNotificationSent, onConsultationUpdated, onCrearFactura, onVerificarEstadoFactura }: ReportViewProps) {\n  const [emailSent, setEmailSent] = useState(false);\n  const [isSending, setIsSending] = useState(false);\n  const [facturando, setFacturando] = useState(false);\n  const [estadoActual, setEstadoActual] = useState<'ABIERTA' | 'CERRADA'>(consultation.estado ?? 'ABIERTA');\n  const [cambiandoEstado, setCambiandoEstado] = useState(false);\n\n  const companyServicios = servicios.filter(s => s.idCompania === company.id && s.activo);\n  // Una consulta solo puede tener una Factura (no Nota de Crédito) para siempre — ver el\n  // UNIQUE en facturas.id_consulta (reutilizado tal cual desde ConsultorioDB_schema.sql), que\n  // no distingue por estado ni se libera al anular. Corregir una factura ya emitida es una Nota\n  // de Crédito contra la original (ver FacturacionManager), no una refacturación desde acá — el\n  // botón se deshabilita apenas existe cualquier factura para esta consulta, anulada o no, para\n  // que el estado del botón coincida siempre con lo que el servidor realmente va a aceptar.\n  const facturaExistente = facturas.find(f => f.idConsulta === consultation.id && f.tipoDocumento === '01');\n\n  const handleToggleEstado = async () => {\n    const nuevoEstado = estadoActual === 'CERRADA' ? 'ABIERTA' : 'CERRADA';\n    setCambiandoEstado(true);\n    try {\n      const res = await fetch(`/api/consultations/${consultation.id}/estado`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ estado: nuevoEstado })\n      });","node_kind":"component"},{"id":"reportview_reportview_handletoggleestado","label":"handleToggleEstado()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L66-L84","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L66"}],"snippet":"handleToggleEstado = async () => {\n    const nuevoEstado = estadoActual === 'CERRADA' ? 'ABIERTA' : 'CERRADA';\n    setCambiandoEstado(true);\n    try {\n      const res = await fetch(`/api/consultations/${consultation.id}/estado`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ estado: nuevoEstado })\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || 'No se pudo actualizar el estado de la consulta.');\n      setEstadoActual(nuevoEstado);\n      onConsultationUpdated(data);\n    } catch (err) {\n      notify.error(err instanceof Error ? err.message : 'No se pudo actualizar el estado de la consulta.');\n    } finally {\n      setCambiandoEstado(false);\n    }\n  }"},{"id":"reportview_reportview_triggerprint","label":"triggerPrint()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L86-L88","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L86"}],"snippet":"triggerPrint = () => {\n    window.print();\n  }"},{"id":"reportview_reportview_sendclientemail","label":"sendClientEmail()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L90-L113","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L90"}],"snippet":"sendClientEmail = async () => {\n    setIsSending(true);\n    try {\n      const res = await fetch('/api/notifications/send', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          tipo: 'CONSULTA',\n          idCompania: company.id,\n          patient,\n          consultation\n        })\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || 'No se pudo enviar el reporte.');\n      onNotificationSent(data);\n      setEmailSent(true);\n      setTimeout(() => setEmailSent(false), 3000);\n    } catch (err: any) {\n      notify.error(`No se pudo enviar el reporte por correo: ${err.message}`);\n    } finally {\n      setIsSending(false);\n    }\n  }"},{"id":"reportview_reportview_getevalabel","label":"getEvaLabel()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L115-L119","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L115"}],"snippet":"getEvaLabel = (score: number) => {\n    if (score >= 8) return 'Severo (Urgente)';\n    if (score >= 5) return 'Moderado';\n    return 'Leve / Tolerable';\n  }"}],"edges":[{"source":"reportview","target":"mockdata","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportView.tsx","source_location":"L1"}],"weight":1},{"source":"reportview","target":"lucide_react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ReportView.tsx",