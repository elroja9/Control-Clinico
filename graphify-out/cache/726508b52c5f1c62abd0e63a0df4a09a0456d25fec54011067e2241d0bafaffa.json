{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"facturacionmanager","label":"FacturacionManager.tsx","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L1"}]},{"id":"facturacionmanager_facturacionmanagerprops","label":"FacturacionManagerProps","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L8-L19","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L8"}],"snippet":"interface FacturacionManagerProps {\n  facturas: Factura[];\n  patients: Patient[];\n  company: Company;\n  servicios: Servicio[];\n  puedeAnular: boolean; // Administrador: anular y Notas de Crédito (el servidor también lo exige)\n  onAnularFactura: (idFactura: number, motivo: string) => Promise<{ factura: Factura; notaCredito: Factura | null }>;\n  onEmitirNotaCredito: (idFactura: number, payload: { motivo: string; lineas: Array<{ idServicio: number; cantidad: number }> }) => Promise<Factura>;\n  onEmitirNotaDebito: (idFactura: number, payload: { motivo: string; lineas: Array<{ idServicio: number; cantidad: number }>; medioPago?: string }) => Promise<Factura>;\n  onVerificarEstadoFactura: (idFactura: number) => Promise<Factura>;\n  onReenviarCorreo: (idFactura: number) => Promise<NotificationLog>;\n}"},{"id":"facturacionmanager_cantidadesacreditadas","label":"cantidadesAcreditadas()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L50-L58","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L50"}],"snippet":"function cantidadesAcreditadas(facturas: Factura[], idFactura: number): Record<number, number> {\n  return facturas\n    .filter(n => n.idFacturaReferencia === idFactura && n.tipoDocumento === '03' && n.estado !== 'ERROR' && n.estado !== 'RECHAZADA')\n    .flatMap(n => n.lineas)\n    .reduce<Record<number, number>>((acc, l) => {\n      if (l.idServicio != null) acc[l.idServicio] = (acc[l.idServicio] || 0) + Number(l.cantidad);\n      return acc;\n    }, {});\n}"},{"id":"facturacionmanager_quedaporacreditar","label":"quedaPorAcreditar()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L60-L67","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L60"}],"snippet":"function quedaPorAcreditar(f: Factura, acreditado: Record<number, number>): boolean {\n  const vendido: Record<number, number> = {};\n  for (const l of f.lineas) {\n    if (l.idServicio == null) return true;\n    vendido[l.idServicio] = (vendido[l.idServicio] || 0) + Number(l.cantidad);\n  }\n  return Object.entries(vendido).some(([id, cantidad]) => cantidad - (acreditado[Number(id)] || 0) > 1e-9);\n}"},{"id":"facturacionmanager_unirfrases","label":"unirFrases()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L70-L72","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L70"}],"snippet":"function unirFrases(partes: string[]): string {\n  return partes.length <= 1 ? (partes[0] || '') : `${partes.slice(0, -1).join(', ')} y ${partes[partes.length - 1]}`;\n}"},{"id":"facturacionmanager_explicacionanulacion","label":"explicacionAnulacion()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L76-L93","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L76"}],"snippet":"function explicacionAnulacion(f: Factura, acreditado: Record<number, number>): string {\n  const pendiente = quedaPorAcreditar(f, acreditado);\n  let inicio: string;\n  if (f.estado === 'ACEPTADA') {\n    inicio = pendiente\n      ? 'Se emite y transmite a Hacienda una Nota de Crédito que anula esta factura'\n      : 'No se emite otra Nota de Crédito: las anteriores ya acreditaron la factura completa. Se anula en el sistema';\n  } else if (f.estado === 'ERROR') {\n    inicio = 'Primero se consulta a Hacienda: si la tiene aceptada, se emite una Nota de Crédito; si nunca le llegó, se anula solo en el sistema';\n  } else {\n    inicio = `No se emite Nota de Crédito porque esta factura ${MOTIVO_SIN_NOTA_CREDITO[f.estado] || `no fue aceptada por Hacienda (estado ${f.estado})`}; se anula solo en el sistema`;\n  }\n  const efectos: string[] = [];\n  if (pendiente && f.lineas.some(l => l.tipo === 'ARTICULO')) efectos.push('se reponen las existencias de los artículos facturados');\n  if (f.condicionVenta === '02') efectos.push('se anula el saldo pendiente de cobro');\n  if (f.idConsulta != null) efectos.push('se libera la consulta para volver a facturarla');\n  return `${inicio}.${efectos.length ? ` Además, ${unirFrases(efectos)}.` : ''} No se puede deshacer.`;\n}"},{"id":"facturacionmanager_facturacionmanager","label":"FacturacionManager()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L95-L332","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L95"}],"snippet":"export default function FacturacionManager({ facturas, patients, company, servicios, puedeAnular, onAnularFactura, onEmitirNotaCredito, onEmitirNotaDebito, onVerificarEstadoFactura, onReenviarCorreo }: FacturacionManagerProps) {\n  const [anulandoId, setAnulandoId] = useState<number | null>(null);\n  const [motivoAnulacion, setMotivoAnulacion] = useState('');\n  const [anulando, setAnulando] = useState(false);\n  const [error, setError] = useState('');\n  const [verificandoId, setVerificandoId] = useState<number | null>(null);\n  const [viewingFactura, setViewingFactura] = useState<Factura | null>(null);\n  const [ajustando, setAjustando] = useState<{ tipo: 'CREDITO' | 'DEBITO'; factura: Factura } | null>(null);\n\n  const handleVerificarEstado = async (id: number) => {\n    setVerificandoId(id);\n    try {\n      const actualizada = await onVerificarEstadoFactura(id);\n      // El mensaje va primero: una Nota ACEPTADA puede traer el aviso de que su ajuste de inventario\n      // o cuenta por cobrar hay que hacerlo a mano, y un \"aceptado\" verde lo escondería.\n      if (actualizada.estado === 'RECHAZADA') notify.error(actualizada.mensajeError || 'Hacienda rechazó el comprobante.', 'Comprobante rechazado');\n      else if (actualizada.mensajeError) notify.warning(actualizada.mensajeError, actualizada.estado === 'ACEPTADA' ? 'Aceptado — requiere ajuste manual' : undefined);\n      else if (actualizada.estado === 'ACEPTADA') notify.success(`Hacienda aceptó el comprobante ${actualizada.consecutivo}.`);\n      else notify.info('Hacienda todavía está procesando el comprobante. Vuelva a verificar en unos minutos.');\n    } catch (err: any) {\n      // Antes este error iba al recuadro del panel de anulación, que casi nunca está abierto.\n      notify.error(err.message || 'No se pudo verificar el estado con Hacienda.');\n    } finally {\n      setVerificandoId(null);\n    }","node_kind":"component"},{"id":"facturacionmanager_facturacionmanager_handleverificarestado","label":"handleVerificarEstado()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L104-L120","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L104"}],"snippet":"handleVerificarEstado = async (id: number) => {\n    setVerificandoId(id);\n    try {\n      const actualizada = await onVerificarEstadoFactura(id);\n      // El mensaje va primero: una Nota ACEPTADA puede traer el aviso de que su ajuste de inventario\n      // o cuenta por cobrar hay que hacerlo a mano, y un \"aceptado\" verde lo escondería.\n      if (actualizada.estado === 'RECHAZADA') notify.error(actualizada.mensajeError || 'Hacienda rechazó el comprobante.', 'Comprobante rechazado');\n      else if (actualizada.mensajeError) notify.warning(actualizada.mensajeError, actualizada.estado === 'ACEPTADA' ? 'Aceptado — requiere ajuste manual' : undefined);\n      else if (actualizada.estado === 'ACEPTADA') notify.success(`Hacienda aceptó el comprobante ${actualizada.consecutivo}.`);\n      else notify.info('Hacienda todavía está procesando el comprobante. Vuelva a verificar en unos minutos.');\n    } catch (err: any) {\n      // Antes este error iba al recuadro del panel de anulación, que casi nunca está abierto.\n      notify.error(err.message || 'No se pudo verificar el estado con Hacienda.');\n    } finally {\n      setVerificandoId(null);\n    }\n  }"},{"id":"facturacionmanager_facturacionmanager_nombrepaciente","label":"nombrePaciente()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L124","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L124"}],"snippet":"nombrePaciente = (idPaciente: number) => patients.find(p => p.id === idPaciente)?.nombreCompleto || `Paciente #${idPaciente}`"},{"id":"facturacionmanager_facturacionmanager_referenciafactura","label":"referenciaFactura()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L125-L128","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L125"}],"snippet":"referenciaFactura = (idFacturaReferencia: number | null) => {\n    if (idFacturaReferencia == null) return null;\n    return facturas.find(f => f.id === idFacturaReferencia)?.consecutivo || `#${idFacturaReferencia}`;\n  }"},{"id":"facturacionmanager_facturacionmanager_puedeajustar","label":"puedeAjustar()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L131","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L131"}],"snippet":"puedeAjustar = (f: Factura) => f.tipoDocumento === '01' && f.estado === 'ACEPTADA'"},{"id":"facturacionmanager_facturacionmanager_puedeanularfactura","label":"puedeAnularFactura()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L134","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L134"}],"snippet":"puedeAnularFactura = (f: Factura) => puedeAnular && f.tipoDocumento === '01' && f.estado !== 'ANULADA' && f.estado !== 'ENVIADA'"},{"id":"facturacionmanager_facturacionmanager_puedeverificar","label":"puedeVerificar()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L135","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L135"}],"snippet":"puedeVerificar = (f: Factura) => f.estado === 'ENVIADA' || f.estado === 'ERROR'"},{"id":"facturacionmanager_facturacionmanager_handleconfirmaranular","label":"handleConfirmarAnular()","file_type":"code","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L137-L156","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L137"}],"snippet":"handleConfirmarAnular = async (id: number) => {\n    if (!motivoAnulacion.trim()) {\n      setError('Indique el motivo de la anulación.');\n      return;\n    }\n    setAnulando(true);\n    setError('');\n    try {\n      const { factura, notaCredito } = await onAnularFactura(id, motivoAnulacion.trim());\n      notify.success(notaCredito\n        ? `Factura ${factura.consecutivo} anulada con la Nota de Crédito ${notaCredito.consecutivo} (${notaCredito.estado}).`\n        : `Factura ${factura.consecutivo} anulada en el sistema, sin Nota de Crédito.`);\n      setAnulandoId(null);\n      setMotivoAnulacion('');\n    } catch (err: any) {\n      setError(err.message || 'No se pudo anular la factura.');\n    } finally {\n      setAnulando(false);\n    }\n  }"}],"edges":[{"source":"facturacionmanager","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L1"}],"weight":1},{"source":"facturacionmanager","target":"mockdata","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/FacturacionManager.tsx","source_location":"L2","layer":"bas