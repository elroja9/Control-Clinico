{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"consultationform","label":"ConsultationForm.tsx","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L1"}]},{"id":"consultationform_consultationformprops","label":"ConsultationFormProps","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L8-L17","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L8"}],"snippet":"interface ConsultationFormProps {\n  patient: Patient;\n  editingConsultation: Consultation | null;\n  onSave: (consultation: Consultation) => void;\n  onCancel: () => void;\n  themeColor: string;\n  perfilCompania: 'Fisioterapia' | 'Nutrición' | 'Ambas';\n  porcentajesDieta: PorcentajeDieta[];\n  plantillasDieta: PlantillaDieta[];\n}"},{"id":"consultationform_consultationform","label":"ConsultationForm()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L19-L2333","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L19"}],"snippet":"export default function ConsultationForm({ patient, editingConsultation, onSave, onCancel, themeColor, perfilCompania, porcentajesDieta, plantillasDieta }: ConsultationFormProps) {\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  // Ref (not state) because two clicks fired in the same tick both read the same\n  // stale `isSubmitting` value before React re-renders — only a ref updates synchronously\n  // in time to block the second one. Without this, a double-click created two separate\n  // consultation rows (the backend has no way to tell them apart from two real saves).\n  const isSubmittingRef = useRef(false);\n  const [tipo, setTipo] = useState<'Nutrición' | 'Fisioterapia'>(() => {\n    if (perfilCompania === 'Fisioterapia') return 'Fisioterapia';\n    return 'Nutrición';\n  });\n\n  useEffect(() => {\n    if (perfilCompania === 'Fisioterapia') {\n      setTipo('Fisioterapia');\n    } else if (perfilCompania === 'Nutrición') {\n      setTipo('Nutrición');\n    }\n  }, [perfilCompania]);\n  const [fecha, setFecha] = useState(new Date().toISOString().split('T')[0]);\n  const [motivo, setMotivo] = useState('');\n  const [horasSueno, setHorasSueno] = useState(7);\n  const [compromiso, setCompromiso] = useState(8);\n  const [anotaciones, setAnotaciones] = useState('');","node_kind":"component"},{"id":"consultationform_consultationform_invalidarrestaurado","label":"invalidarRestaurado()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L199-L203","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L199"}],"snippet":"invalidarRestaurado = () => {\n    setTmbRestaurado(null);\n    setPromedioRestaurado(null);\n    setPrescripcionAplicada(false);\n  }"},{"id":"consultationform_consultationform_handleaplicarprescripcion","label":"handleAplicarPrescripcion()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L235-L240","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L235"}],"snippet":"handleAplicarPrescripcion = () => {\n    if (tmbSeleccionado == null || prescripcionFinal == null) return;\n    setTmb(Math.round(tmbSeleccionado));\n    setCalorias(Math.round(prescripcionFinal));\n    setPrescripcionAplicada(true);\n  }"},{"id":"consultationform_consultationform_handleaplicarplantilla","label":"handleAplicarPlantilla()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L242-L255","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L242"}],"snippet":"handleAplicarPlantilla = (plantilla: PlantillaDieta) => {\n    setDesayuno(plantilla.desayuno);\n    setMeriendaMan(plantilla.meriendaManana);\n    setAlmuerzo(plantilla.almuerzo);\n    setMeriendaTar(plantilla.meriendaTarde);\n    setCena(plantilla.cena);\n    setIndicacionesDieta(plantilla.indicaciones);\n    // Las plantillas ya guardan % de la distribución calórica, igual que estos campos — copia\n    // directa, sin conversión.\n    setMacrosCarbohidratosPct(plantilla.carbohidratosPct != null ? String(plantilla.carbohidratosPct) : '');\n    setMacrosProteinasPct(plantilla.proteinasPct != null ? String(plantilla.proteinasPct) : '');\n    setMacrosGrasasPct(plantilla.grasasPct != null ? String(plantilla.grasasPct) : '');\n    handleAplicarPrescripcion();\n  }"},{"id":"consultationform_consultationform_handleformsubmit","label":"handleFormSubmit()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L441-L634","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L441"}],"snippet":"handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (isSubmittingRef.current) return;\n    if (!motivo.trim()) {\n      notify.warning(\"Indique el motivo de la consulta.\");\n      return;\n    }\n    if (todosLosMacrosPctLlenos && sumaMacrosPct !== 100) {\n      notify.warning(\"La distribución de macronutrientes (carbohidratos + proteínas + grasas) debe sumar 100% cuando los tres campos tienen valor.\");\n      return;\n    }\n    isSubmittingRef.current = true;\n    setIsSubmitting(true);\n\n    const newConsultation: Consultation = {\n      id: editingConsultation?.id ?? Date.now(),\n      estado: editingConsultation?.estado ?? 'ABIERTA',\n      idPaciente: patient.id,\n      idCompania: patient.idCompania,\n      fecha,\n      tipo,\n      motivo,\n      horasSueno,\n      compromiso,\n      anotacionesGenerales: anotaciones,"}],"edges":[{"source":"consultationform","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L1"}],"weight":1},{"source":"consultationform","target":"mockdata","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L2"}],"weight":1},{"source":"consultationform","target":"lucide_react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L3"}],"weight":1},{"source":"consultationform","target":"painmapselector","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ConsultationForm.tsx","source_location":"L4","layer":"base","provenance":[{"capability_