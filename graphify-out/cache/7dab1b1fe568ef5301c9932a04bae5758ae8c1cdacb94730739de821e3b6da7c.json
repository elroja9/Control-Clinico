{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"haciendasigner","label":"haciendaSigner.ts","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L1"}]},{"id":"haciendasigner_llavesp12","label":"LlavesP12","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L39-L43","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L39"}],"snippet":"interface LlavesP12 {\n  certificadoBase64: string; // DER (X.509), base64\n  llavePrivadaBase64: string; // DER (PKCS8), base64 — formato que crypto.subtle.importKey('pkcs8', ...) exige\n  llavePublicaBase64: string; // DER (SPKI), base64 — formato que crypto.subtle.importKey('spki', ...) exige\n}"},{"id":"haciendasigner_dertobase64","label":"derToBase64()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L45-L47","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L45"}],"snippet":"function derToBase64(asn1Obj: forge.asn1.Asn1): string {\n  return forge.util.encode64(forge.asn1.toDer(asn1Obj).getBytes());\n}"},{"id":"haciendasigner_separarp12","label":"separarP12()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L51-L82","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L51"}],"snippet":"function separarP12(p12Base64: string, pin: string): LlavesP12 {\n  let p12: forge.pkcs12.Pkcs12Pfx;\n  try {\n    const asn1 = forge.asn1.fromDer(forge.util.decode64(p12Base64));\n    p12 = forge.pkcs12.pkcs12FromAsn1(asn1, true, pin);\n  } catch (err) {\n    throw new Error('No se pudo leer la llave criptográfica (.p12): verifique el archivo y el PIN configurados en Configuración de Emisor.');\n  }\n\n  const keyBags = (p12.getBags({ bagType: forge.pki.oids.pkcs8ShroudedKeyBag })[forge.pki.oids.pkcs8ShroudedKeyBag] || [])\n    .concat(p12.getBags({ bagType: forge.pki.oids.keyBag })[forge.pki.oids.keyBag] || []);\n  const certBags = p12.getBags({ bagType: forge.pki.oids.certBag })[forge.pki.oids.certBag] || [];\n\n  if (keyBags.length === 0 || !keyBags[0].key) {\n    throw new Error('La llave criptográfica (.p12) no contiene una llave privada válida.');\n  }\n  if (certBags.length === 0 || !certBags[0].cert) {\n    throw new Error('La llave criptográfica (.p12) no contiene un certificado válido.');\n  }\n\n  const privateKey = keyBags[0].key;\n  const cert = certBags[0].cert!;\n\n  const privateKeyInfo = forge.pki.wrapRsaPrivateKey(forge.pki.privateKeyToAsn1(privateKey));\n  const publicKey = forge.pki.setRsaPublicKey(privateKey.n, privateKey.e);"},{"id":"haciendasigner_base64toarraybuffer","label":"base64ToArrayBuffer()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L84-L86","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L84"}],"snippet":"function base64ToArrayBuffer(base64: string): ArrayBuffer {\n  return Uint8Array.from(Buffer.from(base64, 'base64')).buffer;\n}"},{"id":"haciendasigner_infocertificadop12","label":"InfoCertificadoP12","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L88-L95","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L88"}],"snippet":"export interface InfoCertificadoP12 {\n  sujeto: string;\n  emisor: string;\n  numeroSerie: string;\n  validoDesde: string;\n  validoHasta: string;\n  expirado: boolean;\n}"},{"id":"haciendasigner_verificarllavep12","label":"verificarLlaveP12()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L101-L134","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L101"}],"snippet":"export function verificarLlaveP12(p12Base64: string, pin: string): InfoCertificadoP12 {\n  let p12: forge.pkcs12.Pkcs12Pfx;\n  try {\n    const asn1 = forge.asn1.fromDer(forge.util.decode64(p12Base64));\n    p12 = forge.pkcs12.pkcs12FromAsn1(asn1, true, pin);\n  } catch (err) {\n    throw new Error('No se pudo leer la llave criptográfica (.p12): verifique el archivo y el PIN configurados en Configuración de Emisor.');\n  }\n\n  const keyBags = (p12.getBags({ bagType: forge.pki.oids.pkcs8ShroudedKeyBag })[forge.pki.oids.pkcs8ShroudedKeyBag] || [])\n    .concat(p12.getBags({ bagType: forge.pki.oids.keyBag })[forge.pki.oids.keyBag] || []);\n  const certBags = p12.getBags({ bagType: forge.pki.oids.certBag })[forge.pki.oids.certBag] || [];\n\n  if (keyBags.length === 0 || !keyBags[0].key) {\n    throw new Error('La llave criptográfica (.p12) no contiene una llave privada válida.');\n  }\n  if (certBags.length === 0 || !certBags[0].cert) {\n    throw new Error('La llave criptográfica (.p12) no contiene un certificado válido.');\n  }\n\n  const cert = certBags[0].cert!;\n  const ahora = new Date();\n  const attrsToString = (attrs: forge.pki.CertificateField[]) =>\n    attrs.map(a => `${a.shortName || a.name || a.type}=${a.value}`).join(', ');"},{"id":"haciendasigner_verificarllavep12_attrstostring","label":"attrsToString()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L123-L124","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L123"}],"snippet":"attrsToString = (attrs: forge.pki.CertificateField[]) =>\n    attrs.map(a => `${a.shortName || a.name || a.type}=${a.value}`).join(', ')"},{"id":"haciendasigner_firmarxadesepes","label":"firmarXadesEpes()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L140-L195","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L140"}],"snippet":"export async function firmarXadesEpes(xml: string, p12Base64: string, pin: string): Promise<string> {\n  const { certificadoBase64, llavePrivadaBase64, llavePublicaBase64 } = separarP12(p12Base64, pin);\n\n  const privateKey = await webcrypto.subtle.importKey(\n    'pkcs8',\n    base64ToArrayBuffer(llavePrivadaBase64),\n    ALGORITMO_FIRMA,\n    false,\n    ['sign']\n  );\n  const publicKey = await webcrypto.subtle.importKey(\n    'spki',\n    base64ToArrayBuffer(llavePublicaBase64),\n    ALGORITMO_FIRMA,\n    true,\n    ['verify']\n  );\n\n  // Sanitizar la cadena eliminando firmas previas antes de pasarla al parser de xadesjs.\n  const xmlSinFirmaPrevia = xml.replace(/<(?:\\w+:)?Signature\\b[\\s\\S]*?<\\/(?:\\w+:)?Signature>/g, '');\n\n  const documento = Parse(xmlSinFirmaPrevia);\n  const firmador = new SignedXml();\n\n  const firma = await firmador.Sign("}],"edges":[{"source":"haciendasigner","target":"crypto","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L8","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaSigner.ts","source_location":"L8"}],"weight":1},{"source":"haciendasigner","target":"node_forge"