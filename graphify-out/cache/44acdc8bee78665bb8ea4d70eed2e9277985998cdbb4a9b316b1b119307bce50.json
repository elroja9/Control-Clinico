o); }, [periodo]);\n\n  // Cierra un período. Si el servidor responde que hay comprobantes que Hacienda todavía no resolvió,\n  // los muestra y solo cierra con una segunda confirmación explícita.\n  const cerrarPeriodo = async (url: string, body: object): Promise<any> => {","node_kind":"component"},{"id":"reportesfiscales_reportesfiscales_cargard104","label":"cargarD104()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportesFiscales.tsx","source_location":"L41-L49","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportesFiscales.tsx","source_location":"L41"}],"snippet":"cargarD104 = (p: string) => {\n    setCargandoD104(true);\n    setErrorD104('');\n    fetch(`/api/reportes/d104?periodo=${p}`)\n      .then(res => res.json().then(data => ({ ok: res.ok, data })))\n      .then(({ ok, data }) => { if (!ok) throw new Error(data.error); setD104(data); })\n      .catch(err => setErrorD104(err.message || 'No se pudo cargar el reporte D-104.'))\n      .finally(() => setCargandoD104(false));\n  }"},{"id":"reportesfiscales_reportesfiscales_cerrarperiodo","label":"cerrarPeriodo()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReportesFiscales.tsx","source_location":"L55-L74","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReportesFiscales.tsx","source_location":"L55"}],"snippet":"cerrarPeriodo = async (url: string, body: object): Promise<any> => {\n    const enviar = (confirmarPendientes: boolean) => fetch(url, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ ...body, confirmarPendientes })\n    }).then(async res => ({ res, data: await res.json() }));\n    let { res, data } = await enviar(false);\n    if (res.status === 409 && Array.isArray(data.pendientes)) {\n      const cerrarIgual 