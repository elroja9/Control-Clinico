 'PAGADA'>('TODAS');\n\n  const [xmlPendiente, setXmlPendiente] = useState<{ nombreArchivo: string; xmlTexto: string } | null>(null);\n  const [xmlAlimentaInventario, setXmlAlimentaInventario] = useState(true);\n  const [xmlError, setXmlError] = useState('');\n  const [xmlImportando, setXmlImportando] = useState(false);\n  const [xmlResultado, setXmlResultado] = useState<ImportarXmlResultado | null>(null);\n\n  const [formAbierto, setFormAbierto] = useState(false);\n  const [idProveedor, setIdProveedor] = useState('');\n  const [numeroFactura, setNumeroFactura] = useState('');\n  const [modo, setModo] = useState<'GASTO' | 'ARTICULOS'>('GASTO');\n  const [montoTotal, setMontoTotal] = useState('');\n  const [plazoDias, setPlazoDias] = useState('30');\n  const [notas, setNotas] = useState('');\n  const [ivaAcreditable, setIvaAcreditable] = useState('');\n  const [lineas, setLineas] = useState<LineaForm[]>([{ idServicio: '', cantidad: '1', costoUnitario: '' }]);\n  const [error, setError] = useState('');\n  const [guardando, setGuardando] = useState(false);\n\n  const [abonandoId, setAbonandoId] = useState<number | null>(null);\n  const [montoAbono, setMontoAbono] = useState('');\n  const [medioPagoAbono, setMedioPagoAbono] = useState('03');\n  const [referenciaAbono, setReferenciaAbono] = useState('');","node_kind":"component"},{"id":"cxpmanager_cxpmanager_nombreproveedor","label":"nombreProveedor()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L91","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L91"}],"snippet":"nombreProveedor = (idProveedor: number) => proveedores.find(p => p.id === idProveedor)?.nombre || `Proveedor #${idProveedor}`"},{"id":"cxpmanager_cxpmanager_abrirform","label":"abrirForm()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L100-L111","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L100"}],"snippet":"abrirForm = () => {\n    setIdProveedor('');\n    setNumeroFactura('');\n    setModo('GASTO');\n    setMontoTotal('');\n    setPlazoDias('30');\n    setNotas('');\n    setIvaAcreditable('');\n    setLineas([{ idServicio: '', cantidad: '1', costoUnitario: '' }]);\n    setError('');\n    setFormAbierto(true);\n  }"},{"id":"cxpmanager_cxpmanager_handlexmlfilechange","label":"handleXmlFileChange()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L113-L128","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L113"}],"snippet":"handleXmlFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setXmlError('');\n    setXmlResultado(null);\n    const reader = new FileReader();\n    reader.onload = () => {\n      if (typeof reader.result !== 'string') return;\n      setXmlPendiente({ nombreArchivo: file.name, xmlTexto: reader.result });\n      setXmlAlimentaInventario(true);\n      setFormAbierto(false);\n    };\n    reader.onerror = () => setXmlError('No se pudo leer el archivo.');\n    reader.readAsText(file);\n    e.target.value = '';\n  }"},{"id":"cxpmanager_cxpmanager_handleconfirmarimportacionxml","label":"handleConfirmarImportacionXml()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L130-L150","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L130"}],"snippet":"handleConfirmarImportacionXml = async () => {\n    if (!xmlPendiente) return;\n    const ok = await confirmar({\n      title: '¿Importar esta factura de proveedor?',\n      message: `Se registrará \"${xmlPendiente.nombreArchivo}\" como cuenta por pagar${xmlAlimentaInventario ? ' y se incrementará el inventario' : ''}. Esta acción no se puede deshacer.`,\n      confirmText: 'Importar',\n      tone: 'warning'\n    });\n    if (!ok) return;\n    setXmlImportando(true);\n    setXmlError('');\n    try {\n      const resultado = await onImportarXml(xmlPendiente.xmlTexto, xmlAlimentaInventario);\n      setXmlResultado(resultado);\n      setXmlPendiente(null);\n    } catch (err: any) {\n      setXmlError(err.message || 'No se pudo importar el archivo XML.');\n    } finally {\n      setXmlImportando(false);\n    }\n  }"},{"id":"cxpmanager_cxpmanager_actualizarlinea","label":"actualizarLinea()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L152-L162","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L152"}],"snippet":"actualizarLinea = (idx: number, campo: keyof LineaForm, valor: string) => {\n    setLineas(prev => prev.map((l, i) => {\n      if (i !== idx) return l;\n      const actualizada = { ...l, [campo]: valor };\n      if (campo === 'idServicio') {\n        const art = articulos.find(a => a.id === parseInt(valor));\n        if (art && art.costoUnitario != null) actualizada.costoUnitario = art.costoUnitario.toString();\n      }\n      return actualizada;\n    }));\n  }"},{"id":"cxpmanager_cxpmanager_handleguardar","label":"handleGuardar()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L167-L225","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L167"}],"snippet":"handleGuardar = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!idProveedor) {\n      setError('Seleccione un proveedor.');\n      return;\n    }\n    setGuardando(true);\n    setError('');\n    const ivaAcreditableNum = ivaAcreditable.trim() ? parseFloat(ivaAcreditable) : 0;\n    if (!Number.isFinite(ivaAcreditableNum) || ivaAcreditableNum < 0) {\n      setError('El IVA acreditable debe ser un monto válido (0 o mayor).');\n      setGuardando(false);\n      return;\n    }\n    try {\n      if (modo === 'GASTO') {\n        const monto = parseFloat(montoTotal);\n        if (!Number.isFinite(monto) || monto <= 0) {\n          setError('Indique un monto total válido.');\n          setGuardando(false);\n          return;\n        }\n        await onCrearCxp({\n          idProveedor: parseInt(idProveedor),\n          numeroFacturaProveedor: numeroFactura.trim(),"},{"id":"cxpmanager_cxpmanager_abrirabono","label":"abrirAbono()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L227-L233","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L227"}],"snippet":"abrirAbono = (c: CuentaPagar) => {\n    setAbonandoId(c.id);\n    setMontoAbono(c.saldoPendiente.toString());\n    setMedioPagoAbono('03');\n    setReferenciaAbono('');\n    setAbonoError('');\n  }"},{"id":"cxpmanager_cxpmanager_confirmarabono","label":"confirmarAbono()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L235-L255","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L235"}],"snippet":"confirmarAbono = async (c: CuentaPagar) => {\n    const monto = parseFloat(montoAbono);\n    if (!Number.isFinite(monto) || monto <= 0) {\n      setAbonoError('Indique un monto válido.');\n      return;\n    }\n    if (monto > c.saldoPendiente) {\n      setAbonoError(`El abono no puede superar el saldo pendiente (₡${c.saldoPendiente.toLocaleString('es-CR')}).`);\n      return;\n    }\n    setAbonando(true);\n    setAbonoError('');\n    try {\n      await onRegistrarPago(c.id, monto, medioPagoAbono, referenciaAbono.trim());\n      setAbonandoId(null);\n    } catch (err: any) {\n      setAbonoError(err.message || 'No se pudo registrar el abono.');\n    } finally {\n      setAbonando(false);\n    }\n  }"}],"edges":[{"source":"cxpmanager","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L1"}],"weight":1},{"source":"cxpmanager","target":"mockdata","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L2"}],"weight":1},{"source":"cxpmanager","target":"lucide_react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L3"}],"weight":1},{"source":"cxpmanager","target":"feedback","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/CxPManager.tsx","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinic