licbooking_irapaso","label":"irAPaso()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L46-L50","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L46"}],"snippet":"irAPaso = (p: Paso) => {\n    setError('');\n    setPaso(p);\n    window.scrollTo({ top: 0 });\n  }"},{"id":"publicbooking_publicbooking_usarubicacionactual","label":"usarUbicacionActual()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L141-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L141"}],"snippet":"usarUbicacionActual = () => {\n    if (!navigator.geolocation) {\n      setError('Tu navegador no soporta geolocalización.');\n      return;\n    }\n    navigator.geolocation.getCurrentPosition(\n      pos => {\n        setPacienteLat(pos.coords.latitude);\n        setPacienteLng(pos.coords.longitude);\n        setDireccionDomicilio(prev => prev || 'Ubicación actual del dispositivo');\n      },\n      () => setError('No se pudo obtener tu ubicación. Escribe tu dirección manualmente.')\n    );\n  }"},{"id":"publicbooking_publicbooking_cargarhorarios","label":"cargarHorarios()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L156-L166","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L156"}],"snippet":"cargarHorarios = () => {\n    if (!profesionalId) return;\n    setCargandoHorarios(true);\n    setHoraSeleccionada('');\n    const servicioParam = servicioId ? `&idServicio=${servicioId}` : '';\n    fetch(`/api/public/disponibilidad?idUsuario=${profesionalId}&fecha=${fecha}&tipoVisita=${tipoVisita}${servicioParam}`)\n      .then(res => res.json())\n      .then(data => setHorariosDisponibles(data))\n      .catch(() => setError('No se pudieron cargar los horarios disponibles.'))\n      .finally(() => setCargandoHorarios(false));\n  }"},{"id":"publicbooking_publicbooking_buscarpacienteporcedula","label":"buscarPacientePorCedula()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L173-L189","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L173"}],"snippet":"buscarPacientePorCedula = () => {\n    if (!cedula.trim() || !clinicaId) return;\n    fetch(`/api/public/clinicas/${clinicaId}/pacientes/${encodeURIComponent(cedula.trim())}`)\n      .then(res => {\n        if (!res.ok) throw new Error('not found');\n        return res.json();\n      })\n      .then(data => {\n        setNombreCompleto(data.nombreCompleto);\n        setTelefono(data.telefono);\n        setCorreoElectronico(data.correoElectronico);\n        setTipoIdentificacion(data.tipoIdentificacion);\n        setFechaNacimiento(data.fechaNacimiento);\n        setPacienteEncontrado(true);\n      })\n      .catch(() => setPacienteEncontrado(false));\n  }"},{"id":"publicbooking_publicbooking_confirmarcita","label":"confirmarCita()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L191-L225","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L191"}],"snippet":"confirmarCita = () => {\n    setError('');\n    if (!nombreCompleto.trim() || !telefono.trim() || !correoElectronico.trim() || !cedula.trim()) {\n      setError('Por favor complete todos los campos.');\n      return;\n    }\n    if (tipoVisita === 'DOMICILIO' && (pacienteLat == null || pacienteLng == null)) {\n      setError('Por favor indique su dirección o use su ubicación actual.');\n      return;\n    }\n    setSubmitting(true);\n    fetch('/api/public/citas', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        idCompania: clinicaId,\n        idUsuarioNutricionista: profesionalId,\n        idServicio: servicioId || undefined,\n        fechaHora: `${fecha}T${horaSeleccionada}`,\n        tipoVisita,\n        direccionDomicilio: tipoVisita === 'DOMICILIO' ? direccionDomicilio : undefined,\n        pacienteLat: tipoVisita === 'DOMICILIO' ? pacienteLat : undefined,\n        pacienteLng: tipoVisita === 'DOMICILIO' ? pacienteLng : undefined,\n        paciente: { identificacion: cedula, tipoIdentificacion, nombreCompleto, telefono, correoElectronico, fechaNacimiento }\n      })"},{"id":"publicbooking_publicbooking_fechalegible","label":"fechaLegible()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L237-L240","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L237"}],"snippet":"fechaLegible = (f: string) => {\n    const [y, m, d] = f.split('-').map(Number);\n    return new Date(y, m - 1, d).toLocaleDateString('es-CR', { weekday: 'long', day: 'numeric', month: 'long' });\n  }"},{"id":"publicbooking_publicbooking_nuevareserva","label":"nuevaReserva()","file_type":"code","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L248-L256","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/PublicBooking.tsx","source_location":"L248"}],"snippet":"nuevaReserva = () => {\n    setCitaCreada(null);\n    setHoraSeleccionada('');\n    setS