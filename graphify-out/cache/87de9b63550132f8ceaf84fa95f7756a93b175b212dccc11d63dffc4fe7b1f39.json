{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"branding","label":"branding.ts","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L1"}]},{"id":"branding_argb","label":"aRgb()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L14-L25","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L14"}],"snippet":"function aRgb(hex: string): { r: number; g: number; b: number } | null {\n  const limpio = String(hex || \"\").trim().replace(/^#/, \"\");\n  const completo = limpio.length === 3\n    ? limpio.split(\"\").map(c => c + c).join(\"\")\n    : limpio;\n  if (!/^[0-9a-fA-F]{6}$/.test(completo)) return null;\n  return {\n    r: parseInt(completo.slice(0, 2), 16),\n    g: parseInt(completo.slice(2, 4), 16),\n    b: parseInt(completo.slice(4, 6), 16)\n  };\n}"},{"id":"branding_luminancia","label":"luminancia()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L28-L36","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L28"}],"snippet":"function luminancia(hex: string): number | null {\n  const rgb = aRgb(hex);\n  if (!rgb) return null;\n  const canal = (v: number) => {\n    const s = v / 255;\n    return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);\n  };\n  return 0.2126 * canal(rgb.r) + 0.7152 * canal(rgb.g) + 0.0722 * canal(rgb.b);\n}"},{"id":"branding_luminancia_canal","label":"canal()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L31-L34","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L31"}],"snippet":"canal = (v: number) => {\n    const s = v / 255;\n    return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);\n  }"},{"id":"branding_razoncontraste","label":"razonContraste()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L39-L43","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L39"}],"snippet":"function razonContraste(l1: number, l2: number): number {\n  const claro = Math.max(l1, l2);\n  const oscuro = Math.min(l1, l2);\n  return (claro + 0.05) / (oscuro + 0.05);\n}"},{"id":"branding_textosobre","label":"textoSobre()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L55-L61","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L55"}],"snippet":"export function textoSobre(hexFondo: string): string {\n  const l = luminancia(hexFondo);\n  if (l == null) return NEGRO_TEXTO;\n  const contrasteBlanco = razonContraste(l, luminancia(BLANCO_TEXTO)!);\n  const contrasteNegro = razonContraste(l, luminancia(NEGRO_TEXTO)!);\n  return contrasteNegro >= contrasteBlanco ? NEGRO_TEXTO : BLANCO_TEXTO;\n}"},{"id":"branding_tinte","label":"tinte()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L64-L68","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L64"}],"snippet":"export function tinte(hex: string, alpha: number): string {\n  const rgb = aRgb(hex);\n  if (!rgb) return \"rgba(148,163,184,0.12)\";\n  return `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;\n}"},{"id":"branding_colormarca","label":"colorMarca()","file_type":"code","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L71-L73","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L71"}],"snippet":"export function colorMarca(hex: string | null | undefined, respaldo: string): string {\n  return aRgb(hex || \"\") ? String(hex) : respaldo;\n}"}],"edges":[{"source":"branding","target":"branding_argb","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L14","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L14"}],"weight":1},{"source":"branding","target":"branding_luminancia","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L28","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L28"}],"weight":1},{"source":"branding_luminancia","target":"branding_luminancia_canal","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L31","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L31"}],"weight":1},{"source":"branding","target":"branding_razoncontraste","relation":"contains","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L39","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/branding.ts","source_location":"L39"}],"weight":1},{"source":"branding","target":"branding_textosobr