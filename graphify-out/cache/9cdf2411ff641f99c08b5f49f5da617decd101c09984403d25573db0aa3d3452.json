{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"haciendafactura","label":"haciendaFactura.ts","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L1"}]},{"id":"haciendafactura_emisorfactura","label":"EmisorFactura","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L22-L33","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L22"}],"snippet":"export interface EmisorFactura {\n  nombre: string;\n  nombreComercial: string;\n  tipoIdentificacion: string; // '01'..'04'\n  identificacion: string; // solo dígitos\n  correoElectronico: string;\n  provincia: string;\n  canton: string;\n  distrito: string;\n  otrasSenas: string;\n  codigoActividad: string; // 6 dígitos\n}"},{"id":"haciendafactura_receptorfactura","label":"ReceptorFactura","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L35-L40","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L35"}],"snippet":"export interface ReceptorFactura {\n  nombre: string;\n  tipoIdentificacion: string;\n  identificacion: string; // solo dígitos\n  correoElectronico?: string;\n}"},{"id":"haciendafactura_lineafacturainput","label":"LineaFacturaInput","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L42-L49","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L42"}],"snippet":"export interface LineaFacturaInput {\n  codigoCabys: string; // 13 dígitos\n  detalle: string;\n  unidadMedida: string; // 'Sp' | 'Spe' | 'St'\n  cantidad: number;\n  precioUnitario: number;\n  porcentajeIva: number; // ej: 13, 4, 2, 1, 0\n}"},{"id":"haciendafactura_lineafacturacalculada","label":"LineaFacturaCalculada","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L51-L60","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L51"}],"snippet":"export interface LineaFacturaCalculada extends LineaFacturaInput {\n  numeroLinea: number;\n  codigoTarifaIva: string;\n  montoTotal: number;\n  subTotal: number;\n  baseImponible: number;\n  montoIva: number;\n  impuestoNeto: number;\n  montoTotalLinea: number;\n}"},{"id":"haciendafactura_mapearcodigotarifaiva","label":"mapearCodigoTarifaIva()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L80-L87","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L80"}],"snippet":"function mapearCodigoTarifaIva(porcentajeIva: number): string {\n  if (porcentajeIva >= 12.5) return \"08\"; // 13% general\n  if (porcentajeIva >= 3.5) return \"04\"; // 4%\n  if (porcentajeIva >= 1.5) return \"03\"; // 2%\n  if (porcentajeIva >= 0.75) return \"02\"; // 1%\n  if (porcentajeIva >= 0.25) return \"09\"; // 0.5%\n  return \"10\"; // 0% → Exenta (ver comentario arriba)\n}"},{"id":"haciendafactura_esmercanciaporcabys","label":"esMercanciaPorCabys()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L92-L94","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L92"}],"snippet":"function esMercanciaPorCabys(codigoCabys: string): boolean {\n  return /^[0-4]/.test(codigoCabys);\n}"},{"id":"haciendafactura_redondear","label":"redondear()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L99-L102","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L99"}],"snippet":"function redondear(valor: number, decimales: number): number {\n  const factor = Math.pow(10, decimales);\n  return Math.round((Number(valor) + Number.EPSILON) * factor) / factor;\n}"},{"id":"haciendafactura_fmtdinero","label":"fmtDinero()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L104-L106","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L104"}],"snippet":"function fmtDinero(valor: number): string {\n  return redondear(valor, 5).toFixed(5);\n}"},{"id":"haciendafactura_fmtcantidad","label":"fmtCantidad()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L108-L110","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L108"}],"snippet":"function fmtCantidad(valor: number): string {\n  return redondear(valor, 3).toFixed(3);\n}"},{"id":"haciendafactura_fmttarifa","label":"fmtTarifa()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L112-L114","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L112"}],"snippet":"function fmtTarifa(valor: number): string {\n  return redondear(valor, 2).toFixed(2);\n}"},{"id":"haciendafactura_calcularlineas","label":"calcularLineas()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L116-L136","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L116"}],"snippet":"export function calcularLineas(lineas: LineaFacturaInput[]): LineaFacturaCalculada[] {\n  return lineas.map((l, idx) => {\n    const montoTotal = redondear(l.cantidad * l.precioUnitario, 5);\n    const subTotal = montoTotal; // sin descuentos\n    const baseImponible = subTotal;\n    const montoIva = redondear(baseImponible * (l.porcentajeIva / 100), 5);\n    const impuestoNeto = montoIva;\n    const montoTotalLinea = redondear(subTotal + impuestoNeto, 5);\n    return {\n      ...l,\n      numeroLinea: idx + 1,\n      codigoTarifaIva: mapearCodigoTarifaIva(l.porcentajeIva),\n      montoTotal,\n      subTotal,\n      baseImponible,\n      montoIva,\n      impuestoNeto,\n      montoTotalLinea\n    };\n  });\n}"},{"id":"haciendafactura_desgloseimpuestocalculado","label":"DesgloseImpuestoCalculado","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L138-L141","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L138"}],"snippet":"export interface DesgloseImpuestoCalculado {\n  codigoTarifaIva: string;\n  monto: number;\n}"},{"id":"haciendafactura_resumencalculado","label":"ResumenCalculado","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L143-L159","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L143"}],"snippet":"export interface ResumenCalculado {\n  totalServGravados: number;\n  totalServExentos: number;\n  totalMercanciasGravadas: number;\n  totalMercanciasExentas: number;\n  totalGravado: number;\n  totalExento: number;\n  totalExonerado: number; // siempre 0: la app no modela exoneraciones (ver comentario abajo)\n  totalNoSujeto: number; // siempre 0: no se emiten líneas con tarifa 01/11 (no sujeto)\n  totalVenta: number;\n  totalVentaNeta: number;\n  totalImpuesto: number;\n  totalImpAsumEmisorFabrica: number; // siempre 0: la app no asume impuestos por el emisor\n  totalIVADevuelto: number; // siempre 0, ver comentario abajo\n  desgloseImpuesto: DesgloseImpuestoCalculado[];\n  totalComprobante: number;\n}"},{"id":"haciendafactura_calcularresumen","label":"calcularResumen()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L184-L225","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L184"}],"snippet":"export function calcularResumen(lineas: LineaFacturaCalculada[]): ResumenCalculado {\n  const esGravada = (l: LineaFacturaCalculada) => l.codigoTarifaIva !== \"10\";\n  const esServicio = (l: LineaFacturaCalculada) => !esMercanciaPorCabys(l.codigoCabys);\n\n  const sumaSubtotal = (pred: (l: LineaFacturaCalculada) => boolean) =>\n    redondear(lineas.filter(pred).reduce((s, l) => s + l.subTotal, 0), 5);\n\n  const totalServGravados = sumaSubtotal(l => esServicio(l) && esGravada(l));\n  const totalServExentos = sumaSubtotal(l => esServicio(l) && !esGravada(l));\n  const totalMercanciasGravadas = sumaSubtotal(l => !esServicio(l) && esGravada(l));\n  const totalMercanciasExentas = sumaSubtotal(l => !esServicio(l) && !esGravada(l));\n\n  const totalVenta = redondear(lineas.reduce((s, l) => s + l.subTotal, 0), 5);\n  const totalImpuesto = redondear(lineas.reduce((s, l) => s + l.montoIva, 0), 5);\n\n  const desglosePorTarifa = new Map<string, number>();\n  for (const l of lineas.filter(esGravada)) {\n    desglosePorTarifa.set(l.codigoTarifaIva, (desglosePorTarifa.get(l.codigoTarifaIva) || 0) + l.montoIva);\n  }\n  const desgloseImpuesto = Array.from(desglosePorTarifa.entries()).map(([codigoTarifaIva, monto]) => ({\n    codigoTarifaIva,\n    monto: redondear(monto, 5)\n  }));\n\n  return {"},{"id":"haciendafactura_calcularresumen_esgravada","label":"esGravada()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L185","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L185"}],"snippet":"esGravada = (l: LineaFacturaCalculada) => l.codigoTarifaIva !== \"10\""},{"id":"haciendafactura_calcularresumen_esservicio","label":"esServicio()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L186","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L186"}],"snippet":"esServicio = (l: LineaFacturaCalculada) => !esMercanciaPorCabys(l.codigoCabys)"},{"id":"haciendafactura_calcularresumen_sumasubtotal","label":"sumaSubtotal()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L188-L189","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L188"}],"snippet":"sumaSubtotal = (pred: (l: LineaFacturaCalculada) => boolean) =>\n    redondear(lineas.filter(pred).reduce((s, l) => s + l.subTotal, 0), 5)"},{"id":"haciendafactura_limpiarcodigoactividad","label":"limpiarCodigoActividad()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L228-L231","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L228"}],"snippet":"export function limpiarCodigoActividad(actividadEconomica: string): string {\n  const digitos = (actividadEconomica.match(/\\d+/) || [\"000000\"])[0];\n  return digitos.padEnd(6, \"0\").slice(0, 6);\n}"},{"id":"haciendafactura_limpiaridentificacion","label":"limpiarIdentificacion()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L233-L235","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L233"}],"snippet":"export function limpiarIdentificacion(identificacion: string): string {\n  return identificacion.replace(/\\D/g, \"\");\n}"},{"id":"haciendafactura_generarconsecutivo","label":"generarConsecutivo()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L241-L243","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L241"}],"snippet":"export function generarConsecutivo(secuencial: number, sucursal = \"001\", terminal = \"00001\", tipoDocumento = \"01\"): string {\n  return `${sucursal.padStart(3, \"0\")}${terminal.padStart(5, \"0\")}${tipoDocumento}${secuencial.toString().padStart(10, \"0\")}`;\n}"},{"id":"haciendafactura_generarclavenumerica","label":"generarClaveNumerica()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L255-L261","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L255"}],"snippet":"export function generarClaveNumerica(cedulaEmisor: string, consecutivo: string, fecha: Date, situacion = \"1\"): string {\n  const [yyyy, mm, dd] = fechaHoraCR(fecha).slice(0, 10).split(\"-\");\n  const yy = yyyy.slice(-2);\n  const cedula12 = limpiarIdentificacion(cedulaEmisor).padStart(12, \"0\").slice(-12);\n  const codigoSeguridad = Math.floor(Math.random() * 1e8).toString().padStart(8, \"0\");\n  return `506${dd}${mm}${yy}${cedula12}${consecutivo}${situacion}${codigoSeguridad}`;\n}"},{"id":"haciendafactura_fechaemisioncr","label":"fechaEmisionCR()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L269-L271","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L269"}],"snippet":"export function fechaEmisionCR(fecha: Date): string {\n  return fechaHoraCR(fecha);\n}"},{"id":"haciendafactura_escapexml","label":"escapeXml()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L276-L283","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L276"}],"snippet":"function escapeXml(valor: string): string {\n  return valor\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&apos;\");\n}"},{"id":"haciendafactura_datosfacturaxml","label":"DatosFacturaXml","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L285-L295","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L285"}],"snippet":"export interface DatosFacturaXml {\n  clave: string;\n  consecutivo: string;\n  fechaEmision: Date;\n  emisor: EmisorFactura;\n  receptor: ReceptorFactura;\n  condicionVenta: string; // '01' = contado\n  medioPago: string; // '01' = efectivo, '02' = tarjeta, etc.\n  lineas: LineaFacturaCalculada[];\n  resumen: ResumenCalculado;\n}"},{"id":"haciendafactura_construircuerpocomprobante","label":"construirCuerpoComprobante()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L304-L394","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L304"}],"snippet":"function construirCuerpoComprobante(datos: DatosFacturaXml): string {\n  const { clave, consecutivo, fechaEmision, emisor, receptor, condicionVenta, medioPago, lineas, resumen } = datos;\n\n  const lineasXml = lineas.map(l => `\n    <LineaDetalle>\n      <NumeroLinea>${l.numeroLinea}</NumeroLinea>\n      <CodigoCABYS>${escapeXml(l.codigoCabys)}</CodigoCABYS>\n      <Cantidad>${fmtCantidad(l.cantidad)}</Cantidad>\n      <UnidadMedida>${escapeXml(l.unidadMedida)}</UnidadMedida>\n      <Detalle>${escapeXml(l.detalle)}</Detalle>\n      <PrecioUnitario>${fmtDinero(l.precioUnitario)}</PrecioUnitario>\n      <MontoTotal>${fmtDinero(l.montoTotal)}</MontoTotal>\n      <SubTotal>${fmtDinero(l.subTotal)}</SubTotal>\n      <BaseImponible>${fmtDinero(l.baseImponible)}</BaseImponible>\n      <Impuesto>\n        <Codigo>01</Codigo>\n        <CodigoTarifaIVA>${l.codigoTarifaIva}</CodigoTarifaIVA>\n        <Tarifa>${fmtTarifa(l.porcentajeIva)}</Tarifa>\n        <Monto>${fmtDinero(l.montoIva)}</Monto>\n      </Impuesto>\n      <ImpuestoAsumidoEmisorFabrica>${fmtDinero(0)}</ImpuestoAsumidoEmisorFabrica>\n      <ImpuestoNeto>${fmtDinero(l.impuestoNeto)}</ImpuestoNeto>\n      <MontoTotalLinea>${fmtDinero(l.montoTotalLinea)}</MontoTotalLinea>\n    </LineaDetalle>`).join(\"\");"},{"id":"haciendafactura_construirxmlfactura","label":"construirXmlFactura()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L397-L402","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L397"}],"snippet":"export function construirXmlFactura(datos: DatosFacturaXml): string {\n  return `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<FacturaElectronica xmlns=\"${NAMESPACE_FACTURA}\" xmlns:ds=\"${NAMESPACE_DS}\">\n${construirCuerpoComprobante(datos)}\n</FacturaElectronica>`;\n}"},{"id":"haciendafactura_informacionreferenciafactura","label":"InformacionReferenciaFactura","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L406-L415","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L406"}],"snippet":"export interface InformacionReferenciaFactura {\n  tipoDocumento: string; // catálogo \"Tipo de documento de referencia\" — '01' = Factura Electrónica\n  numero: string; // clave de 50 dígitos del documento que se referencia\n  // Fecha de emisión del documento referenciado. Lo normal es pasar el <FechaEmision> tal cual se\n  // guardó (string): así coincide al carácter con el que lleva ese comprobante, aunque se haya\n  // emitido con el formato viejo (ver fechaEmisionCR).\n  fechaEmision: string | Date;\n  codigo: string; // catálogo \"Código de referencia\" — '01' = Anula documento de referencia\n  razon: string; // texto libre explicando el motivo\n}"},{"id":"haciendafactura_datosnotacreditoxml","label":"DatosNotaCreditoXml","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L417-L419","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L417"}],"snippet":"export interface DatosNotaCreditoXml extends DatosFacturaXml {\n  referencia: InformacionReferenciaFactura;\n}"},{"id":"haciendafactura_construirinformacionreferencia","label":"construirInformacionReferencia()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L428-L436","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L428"}],"snippet":"function construirInformacionReferencia(referencia: InformacionReferenciaFactura): string {\n  return `  <InformacionReferencia>\n    <TipoDocIR>${referencia.tipoDocumento}</TipoDocIR>\n    <Numero>${referencia.numero}</Numero>\n    <FechaEmisionIR>${typeof referencia.fechaEmision === \"string\" ? escapeXml(referencia.fechaEmision) : fechaEmisionCR(referencia.fechaEmision)}</FechaEmisionIR>\n    <Codigo>${referencia.codigo}</Codigo>\n    <Razon>${escapeXml(referencia.razon)}</Razon>\n  </InformacionReferencia>`;\n}"},{"id":"haciendafactura_construirxmlnotacredito","label":"construirXmlNotaCredito()","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L441-L447","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L441"}],"snippet":"export function construirXmlNotaCredito(datos: DatosNotaCreditoXml): string {\n  return `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<NotaCreditoElectronica xmlns=\"${NAMESPACE_NOTA_CREDITO}\" xmlns:ds=\"${NAMESPACE_DS}\">\n${construirCuerpoComprobante(datos)}\n${construirInformacionReferencia(datos.referencia)}\n</NotaCreditoElectronica>`;\n}"},{"id":"haciendafactura_datosnotadebitoxml","label":"DatosNotaDebitoXml","file_type":"code","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L451-L453","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/server/haciendaFactura.ts","source_location":"L451"}],"snippet"