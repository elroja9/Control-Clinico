:"handleSelect()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L103-L119","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L103"}],"snippet":"handleSelect = (id: number) => {\n    onSelectCompany(id);\n    const comp = companies.find(c => c.id === id);\n    if (comp) {\n      setEditName(comp.nombreComercial);\n      setEditRazon(comp.razonSocial);\n      setEditIdent(comp.identificacion);\n      setEditCorreo(comp.correoEmisor);\n      setEditIva(comp.ivaPorDefecto);\n      setEditColorPri(comp.colorPrimario);\n      setEditColorSide(comp.colorSidebar);\n      setEditLogo(comp.logoUrl);\n      setEditPerfil(comp.perfilCompania || 'Ambas');\n    }\n    setIsEditing(false);\n    setIsAdding(false);\n  }"},{"id":"companysettings_companysettings_saveedit","label":"saveEdit()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L121-L135","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L121"}],"snippet":"saveEdit = () => {\n    onUpdateCompany({\n      ...currentCompany,\n      nombreComercial: editName,\n      razonSocial: editRazon,\n      identificacion: editIdent,\n      correoEmisor: editCorreo,\n      ivaPorDefecto: parseFloat(editIva.toString()),\n      colorPrimario: editColorPri,\n      colorSidebar: editColorSide,\n      logoUrl: editLogo,\n      perfilCompania: editPerfil\n    });\n    setIsEditing(false);\n  }"},{"id":"companysettings_companysettings_createcompany","label":"createCompany()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L137-L156","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L137"}],"snippet":"createCompany = () => {\n    const newId = Math.max(...companies.map(c => c.id)) + 1;\n    const newComp: Company = {\n      id: newId,\n      nombreComercial: editName || `Nueva Clínica ${newId}`,\n      razonSocial: editRazon || \"Clínica de Rehabilitación S.A.\",\n      tipoIdentificacion: \"02\",\n      identificacion: editIdent || \"3-101-000000\",\n      correoEmisor: editCorreo || \"info@nuevaclinica.com\",\n      ivaPorDefecto: 4.0,\n      colorPrimario: editColorPri || \"#0d9488\",\n      colorSidebar: editColorSide || \"#0f766e\",\n      logoUrl: editLogo || \"https://images.unsplash.com/photo-1516549655169-df83a0774514?w=120&auto=format&fit=crop&q=60\",\n      actividadEconomica: \"869001\",\n      perfilCompania: editPerfil\n    };\n    onAddCompany(newComp);\n    setIsAdding(false);\n    handleSelect(newId);\n  }"},{"id":"companysettings_companysettings_openaddform","label":"openAddForm()","file_type":"code","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L158-L170","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L158"}],"snippet":"openAddForm = () => {\n    setEditName('');\n    setEditRazon('');\n    setEditIdent('');\n    setEditCorreo('');\n    setEditIva(4.0);\n    setEditColorPri('#2563eb');\n    setEditColorSide('#1e3a8a');\n    setEditLogo('https://images.unsplash.com/photo-1516549655169-df83a0774514?w=120&auto=format&fit=crop&q=60');\n    setEditPerfil('Ambas');\n    setIsAdding(true);\n    setIsEditing(false);\n  }"}],"edges":[{"source":"companysettings","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/CompanySettings.tsx","source_location":"L1","layer":"base","provenance":[{"cap