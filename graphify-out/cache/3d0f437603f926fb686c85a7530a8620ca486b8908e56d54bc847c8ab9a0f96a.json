primerDiaMes());\n  const [hasta, setHasta] = useState(ultimoDiaMes());\n  const [reporte, setReporte] = useState<ReporteClientesSesiones | null>(null);\n  const [cargando, setCargando] = useState(false);\n  const [error, setError] = useState('');\n\n  const rangoEfectivo = (): { desde: string; hasta: string } => {\n    if (modo === 'mensual') {\n      const [anio, mesNum] = mes.split('-').map(Number);\n      const ultimo = new Date(anio, mesNum, 0).getDate();\n      return { desde: `${mes}-01`, hasta: `${mes}-${String(ultimo).padStart(2, '0')}` };\n    }\n    return { desde, hasta };\n  };\n\n  const cargarReporte = () => {\n    const { desde: d, hasta: h } = rangoEfectivo();\n    setCargando(true);\n    setError('');\n    fetch(`/api/reportes/clientes-sesiones?desde=${d}&hasta=${h}`)\n      .then(res => res.json().then(data => ({ ok: res.ok, data })))\n      .then(({ ok, data }) => { if (!ok) throw new Error(data.error); setReporte(data); })","node_kind":"component"},{"id":"reporteriaclinica_reporteriaclinica_rangoefectivo","label":"rangoEfectivo()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L46-L53","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L46"}],"snippet":"rangoEfectivo = (): { desde: string; hasta: string } => {\n    if (modo === 'mensual') {\n      const [anio, mesNum] = mes.split('-').map(Number);\n      const ultimo = new Date(anio, mesNum, 0).getDate();\n      return { desde: `${mes}-01`, hasta: `${mes}-${String(ultimo).padStart(2, '0')}` };\n    }\n    return { desde, hasta };\n  }"},{"id":"reporteriaclinica_reporteriaclinica_cargarreporte","label":"cargarReporte()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L55-L64","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L55"}],"snippet":"cargarReporte = () => {\n    const { desde: d, hasta: h } = rangoEfectivo();\n    setCargando(true);\n    setError('');\n    fetch(`/api/reportes/clientes-sesiones?desde=${d}&hasta=${h}`)\n      .then(res => res.json().then(data => ({ ok: res.ok, data })))\n      .then(({ ok, data }) => { if (!ok) throw new Error(data.error); setReporte(data); })\n      .catch(err => setError(err.message || 'No se pudo cargar el reporte.'))\n      .finally(() => setCargando(false));\n  }"},{"id":"reporteriaclinica_reporteriaclinica_exportarcsv","label":"exportarCsv()","file_type":"code","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L68-L82","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L68"}],"snippet":"exportarCsv = () => {\n    if (!reporte) return;\n    const encabezado = 'Paciente,Sesiones Completadas,Nuevo\\n';\n    const filas = reporte.pacientes\n      .map(p => `\"${p.nombreCompleto.replace(/\"/g, '\"\"')}\",${p.sesionesCompletadas},${p.esNuevo ? 'Sí' : 'No'}`)\n      .join('\\n');\n    const blob = new Blob([encabezado + filas], { type: 'text/csv;charset=utf-8;' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    const { desde: d, hasta: h } = rangoEfectivo();\n    a.href = url;\n    a.download = `reporte-pacientes-sesiones-${d}-a-${h}.csv`;\n    a.click();\n    URL.revokeObjectURL(url);\n  }"}],"edges":[{"source":"reporteriaclinica","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/Control-Clinico/src/components/ReporteriaClinica.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/Control-Clinico/